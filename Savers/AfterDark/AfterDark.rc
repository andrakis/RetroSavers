#include <windows.h>
#include <commctrl.h>
#include <scrnsave.h>
#include "resource.h"

// IDS_DESCRIPTION (1): the name shown in the Screen Saver Settings dropdown.
STRINGTABLE
BEGIN
    IDS_DESCRIPTION "After Dark Classics"
END

ID_APP ICON "..\\..\\assets\\RetroSavers.ico"

DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 250, 130
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "After Dark Classics Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Mode:", -1, 12, 12, 50, 10
    COMBOBOX        IDC_MODE, 64, 10, 110, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "&Density:", -1, 12, 36, 50, 10
    CONTROL         "", IDC_DENSITY, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 32, 140, 18
    LTEXT           "5", IDC_DENSITY_LABEL, 210, 36, 30, 10
    LTEXT           "&Speed:", -1, 12, 60, 50, 10
    CONTROL         "", IDC_SPEED, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 56, 140, 18
    LTEXT           "5", IDC_SPEED_LABEL, 210, 60, 30, 10
    AUTOCHECKBOX    "&Rain falls on the desktop", IDC_RAIN_DESKTOP, 12, 82, 140, 10

    PUSHBUTTON      "D&efaults", IDC_DEFAULTS, 12, 104, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 136, 104, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 190, 104, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "After Dark Classics screen saver (RetroSavers)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "AfterDark.scr"
            VALUE "OriginalFilename", "AfterDark.scr"
            VALUE "ProductName", "RetroSavers"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
