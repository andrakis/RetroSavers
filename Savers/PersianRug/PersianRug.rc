#include <windows.h>
#include <commctrl.h>
#include <scrnsave.h>
#include "resource.h"

// IDS_DESCRIPTION (1): the name shown in the Screen Saver Settings dropdown.
STRINGTABLE
BEGIN
    IDS_DESCRIPTION "Persian Rug"
END

ID_APP ICON "..\\..\\assets\\RetroSavers.ico"

DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 260, 190
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Persian Rug Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Detail:", -1, 12, 12, 50, 10
    CONTROL         "", IDC_DETAIL, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 8, 130, 18
    LTEXT           "257 x 257", IDC_DETAIL_LABEL, 200, 12, 54, 10
    LTEXT           "&Colours:", -1, 12, 36, 50, 10
    CONTROL         "", IDC_COLORS, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 32, 130, 18
    LTEXT           "16", IDC_COLORS_LABEL, 200, 36, 54, 10
    LTEXT           "&Speed:", -1, 12, 60, 50, 10
    CONTROL         "", IDC_SPEED, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 56, 130, 18
    LTEXT           "5", IDC_SPEED_LABEL, 200, 60, 54, 10
    LTEXT           "&Hold for:", -1, 12, 84, 50, 10
    CONTROL         "", IDC_HOLD, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 80, 130, 18
    LTEXT           "12 s", IDC_HOLD_LABEL, 200, 84, 54, 10

    LTEXT           "&Palette:", -1, 12, 110, 50, 10
    COMBOBOX        IDC_PALETTE, 64, 108, 90, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "&Layout:", -1, 12, 130, 50, 10
    COMBOBOX        IDC_LAYOUT, 64, 128, 90, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    AUTOCHECKBOX    "C&ycle colours", IDC_CYCLE, 170, 110, 80, 10

    PUSHBUTTON      "&Defaults", IDC_DEFAULTS, 12, 164, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 146, 164, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 164, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Persian Rug screen saver (RetroSavers)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "PersianRug.scr"
            VALUE "OriginalFilename", "PersianRug.scr"
            VALUE "ProductName", "RetroSavers"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
