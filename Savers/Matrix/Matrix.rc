#include <windows.h>
#include <commctrl.h>
#include <scrnsave.h>
#include "resource.h"

// IDS_DESCRIPTION (1): the name shown in the Screen Saver Settings dropdown.
STRINGTABLE
BEGIN
    IDS_DESCRIPTION "Matrix"
END

ID_APP ICON "..\\..\\assets\\RetroSavers.ico"

DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 250, 188
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Matrix Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Speed:", -1, 12, 12, 60, 10
    CONTROL         "", IDC_SPEED, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 76, 8, 130, 18
    LTEXT           "5", IDC_SPEED_LABEL, 212, 12, 30, 10
    LTEXT           "&Density:", -1, 12, 36, 60, 10
    CONTROL         "", IDC_DENSITY, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 76, 32, 130, 18
    LTEXT           "5", IDC_DENSITY_LABEL, 212, 36, 30, 10
    LTEXT           "&Glyph size:", -1, 12, 60, 60, 10
    CONTROL         "", IDC_GLYPH, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 76, 56, 130, 18
    LTEXT           "18", IDC_GLYPH_LABEL, 212, 60, 30, 10

    LTEXT           "&Characters:", -1, 12, 86, 60, 10
    COMBOBOX        IDC_CHARSET, 76, 84, 110, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Colour:", -1, 12, 108, 60, 10
    PUSHBUTTON      "C&olour...", IDC_COLOR, 76, 105, 50, 14
    LTEXT           "", IDC_SWATCH, 132, 105, 24, 14, SS_SUNKEN

    AUTOCHECKBOX    "&Bold heads", IDC_BOLD, 12, 130, 100, 10
    AUTOCHECKBOX    "&Afterglow", IDC_AFTERGLOW, 120, 130, 100, 10

    PUSHBUTTON      "&Defaults", IDC_DEFAULTS, 12, 162, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 136, 162, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 190, 162, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Matrix screen saver (RetroSavers)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Matrix.scr"
            VALUE "OriginalFilename", "Matrix.scr"
            VALUE "ProductName", "RetroSavers"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
