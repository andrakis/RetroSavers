#include <windows.h>
#include <commctrl.h>
#include <scrnsave.h>
#include "resource.h"

STRINGTABLE
BEGIN
    IDS_DESCRIPTION "Aurora"
END

ID_APP ICON "..\\..\\assets\\RetroSavers.ico"

DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 240, 168
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Aurora Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Speed:", -1, 12, 12, 70, 10
    CONTROL         "", IDC_SPEED, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 84, 8, 120, 18
    LTEXT           "5", IDC_SPEED_LABEL, 208, 12, 24, 10
    LTEXT           "Brightness:", -1, 12, 40, 70, 10
    CONTROL         "", IDC_BRIGHTNESS, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 84, 36, 120, 18
    LTEXT           "5", IDC_BRIGHTNESS_LABEL, 208, 40, 24, 10
    LTEXT           "Amplitude:", -1, 12, 68, 70, 10
    CONTROL         "", IDC_AMPLITUDE, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 84, 64, 120, 18
    LTEXT           "5", IDC_AMPLITUDE_LABEL, 208, 68, 24, 10
    LTEXT           "Layers:", -1, 12, 96, 70, 10
    CONTROL         "", IDC_LAYERS, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 84, 92, 120, 18
    LTEXT           "6", IDC_LAYERS_LABEL, 208, 96, 24, 10
    PUSHBUTTON      "&Defaults", IDC_DEFAULTS, 12, 142, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 128, 142, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 182, 142, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Aurora screen saver (RetroSavers)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Aurora.scr"
            VALUE "OriginalFilename", "Aurora.scr"
            VALUE "ProductName", "RetroSavers"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
