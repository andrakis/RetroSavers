#include <windows.h>
#include <commctrl.h>
#include <scrnsave.h>
#include "resource.h"

STRINGTABLE
BEGIN
    IDS_DESCRIPTION "3D Maze"
END

ID_APP ICON "..\\..\\assets\\RetroSavers.ico"

DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 280, 196
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "3D Maze Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Textures (leave blank for the built-in ones)", -1, 8, 6, 264, 72
    LTEXT           "&Walls:", -1, 16, 22, 40, 10
    EDITTEXT        IDC_WALL_PATH, 60, 20, 156, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "Choose...", IDC_WALL_BROWSE, 220, 19, 44, 14
    LTEXT           "&Floor:", -1, 16, 40, 40, 10
    EDITTEXT        IDC_FLOOR_PATH, 60, 38, 156, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "Choose...", IDC_FLOOR_BROWSE, 220, 37, 44, 14
    LTEXT           "&Ceiling:", -1, 16, 58, 40, 10
    EDITTEXT        IDC_CEILING_PATH, 60, 56, 156, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "Choose...", IDC_CEILING_BROWSE, 220, 55, 44, 14

    AUTOCHECKBOX    "Show the &rat", IDC_SHOW_RAT, 12, 88, 100, 10
    AUTOCHECKBOX    "Show the &OpenGL logo", IDC_SHOW_LOGO, 140, 88, 120, 10

    LTEXT           "Maze &size:", -1, 12, 112, 50, 10
    CONTROL         "", IDC_MAZE_SIZE, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 108, 150, 18
    LTEXT           "15 x 15", IDC_MAZE_SIZE_LABEL, 220, 112, 50, 10
    LTEXT           "S&peed:", -1, 12, 136, 50, 10
    CONTROL         "", IDC_SPEED, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 132, 150, 18
    LTEXT           "5", IDC_SPEED_LABEL, 220, 136, 50, 10

    PUSHBUTTON      "&Defaults", IDC_DEFAULTS, 12, 172, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 166, 172, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 220, 172, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "3D Maze screen saver (RetroSavers)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Maze3D.scr"
            VALUE "OriginalFilename", "Maze3D.scr"
            VALUE "ProductName", "RetroSavers"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
