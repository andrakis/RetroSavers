#include <windows.h>
#include <commctrl.h>
#include <scrnsave.h>
#include "resource.h"

// IDS_DESCRIPTION (1): the name shown in the Screen Saver Settings dropdown.
STRINGTABLE
BEGIN
    IDS_DESCRIPTION "Bubbles (Retro)"
END

ID_APP ICON "..\\..\\assets\\RetroSavers.ico"

DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 260, 170
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Bubbles Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Bubbles:", -1, 12, 12, 50, 10
    CONTROL         "", IDC_COUNT, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 8, 150, 18
    LTEXT           "12", IDC_COUNT_LABEL, 220, 12, 30, 10
    LTEXT           "&Size:", -1, 12, 36, 50, 10
    CONTROL         "", IDC_SIZE_TB, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 32, 150, 18
    LTEXT           "5", IDC_SIZE_LABEL, 220, 36, 30, 10
    LTEXT           "S&peed:", -1, 12, 60, 50, 10
    CONTROL         "", IDC_SPEED, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 56, 150, 18
    LTEXT           "5", IDC_SPEED_LABEL, 220, 60, 30, 10

    LTEXT           "&Colours:", -1, 12, 86, 50, 10
    COMBOBOX        IDC_COLOR_MODE, 64, 84, 100, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    PUSHBUTTON      "Colour...", IDC_COLOR, 170, 83, 44, 14
    LTEXT           "", IDC_SWATCH, 220, 83, 24, 14, SS_SUNKEN
    AUTOCHECKBOX    "Show bubbles on the &desktop", IDC_DESKTOP, 12, 108, 140, 10
    AUTOCHECKBOX    "&Wobble", IDC_WOBBLE, 170, 108, 60, 10

    PUSHBUTTON      "&Defaults", IDC_DEFAULTS, 12, 144, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 146, 144, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 144, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Bubbles screen saver (RetroSavers)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "BubblesVista.scr"
            VALUE "OriginalFilename", "BubblesVista.scr"
            VALUE "ProductName", "RetroSavers"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
