#include <windows.h>
#include <commctrl.h>
#include <scrnsave.h>
#include "resource.h"

STRINGTABLE
BEGIN
    IDS_DESCRIPTION "3D Pipes"
END

ID_APP ICON "..\\..\\assets\\RetroSavers.ico"

DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 260, 206
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "3D Pipes Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Pipes", -1, 8, 6, 244, 30
    AUTORADIOBUTTON "&Single", IDC_PIPES_SINGLE, 16, 18, 60, 10, WS_GROUP
    AUTORADIOBUTTON "&Multiple", IDC_PIPES_MULTIPLE, 90, 18, 60, 10

    LTEXT           "&Joint type:", -1, 12, 48, 60, 10
    COMBOBOX        IDC_JOINT, 80, 46, 90, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "S&urface style:", -1, 12, 68, 60, 10
    COMBOBOX        IDC_SURFACE, 80, 66, 90, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "&Texture:", -1, 12, 88, 60, 10
    EDITTEXT        IDC_TEXTURE_PATH, 80, 86, 120, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "Choose...", IDC_TEXTURE_BROWSE, 204, 85, 44, 14

    LTEXT           "&Resolution:", -1, 12, 112, 60, 10
    CONTROL         "", IDC_RESOLUTION, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 80, 108, 130, 18
    LTEXT           "16", IDC_RESOLUTION_LABEL, 216, 112, 30, 10
    LTEXT           "S&peed:", -1, 12, 136, 60, 10
    CONTROL         "", IDC_SPEED, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 80, 132, 130, 18
    LTEXT           "5", IDC_SPEED_LABEL, 216, 136, 30, 10
    AUTOCHECKBOX    "Smooth &growth", IDC_SMOOTH, 12, 158, 120, 10

    PUSHBUTTON      "&Defaults", IDC_DEFAULTS, 12, 182, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 146, 182, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 182, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "3D Pipes screen saver (RetroSavers)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Pipes3D.scr"
            VALUE "OriginalFilename", "Pipes3D.scr"
            VALUE "ProductName", "RetroSavers"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
