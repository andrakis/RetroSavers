#include <windows.h>
#include <commctrl.h>
#include <scrnsave.h>
#include "resource.h"

// IDS_DESCRIPTION (1): the name shown in the Screen Saver Settings dropdown.
STRINGTABLE
BEGIN
    IDS_DESCRIPTION "Photos (Retro)"
END

ID_APP ICON "..\\..\\assets\\RetroSavers.ico"

DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 280, 168
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Photos Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Folder:", -1, 12, 14, 50, 10
    EDITTEXT        IDC_FOLDER, 64, 12, 174, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BROWSE, 242, 11, 30, 14

    LTEXT           "&Interval:", -1, 12, 38, 50, 10
    CONTROL         "", IDC_INTERVAL, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 34, 170, 18
    LTEXT           "8 s", IDC_INTERVAL_LABEL, 240, 38, 34, 10

    LTEXT           "&Transition:", -1, 12, 62, 50, 10
    COMBOBOX        IDC_TRANSITION, 64, 60, 100, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "&Sizing:", -1, 12, 82, 50, 10
    COMBOBOX        IDC_FIT, 64, 80, 100, 60, CBS_DROPDOWNLIST | WS_TABSTOP

    AUTOCHECKBOX    "S&huffle", IDC_SHUFFLE, 176, 62, 90, 10
    AUTOCHECKBOX    "Include s&ubfolders", IDC_SUBFOLDERS, 176, 82, 90, 10
    AUTOCHECKBOX    "Show file &name", IDC_FILENAME, 12, 104, 90, 10
    AUTOCHECKBOX    "Slow &pan and zoom", IDC_KENBURNS, 176, 104, 90, 10

    PUSHBUTTON      "&Defaults", IDC_DEFAULTS, 12, 142, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 166, 142, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 220, 142, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Photos screen saver (RetroSavers)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Photos.scr"
            VALUE "OriginalFilename", "Photos.scr"
            VALUE "ProductName", "RetroSavers"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
