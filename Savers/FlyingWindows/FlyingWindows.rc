#include <windows.h>
#include <commctrl.h>
#include <scrnsave.h>
#include "resource.h"

// IDS_DESCRIPTION (1): the name shown in the Screen Saver Settings dropdown.
STRINGTABLE
BEGIN
    IDS_DESCRIPTION "Flying Windows"
END

ID_APP ICON "..\\..\\assets\\RetroSavers.ico"

DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 270, 190
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Flying Windows Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Density:", -1, 12, 12, 50, 10
    CONTROL         "", IDC_DENSITY, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 8, 160, 18
    LTEXT           "40", IDC_DENSITY_LABEL, 230, 12, 30, 10
    LTEXT           "&Warp speed:", -1, 12, 36, 50, 10
    CONTROL         "", IDC_SPEED, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 32, 160, 18
    LTEXT           "5", IDC_SPEED_LABEL, 230, 36, 30, 10

    LTEXT           "&Image:", -1, 12, 62, 50, 10
    EDITTEXT        IDC_IMAGE_PATH, 64, 60, 140, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_IMAGE_BROWSE, 208, 59, 22, 14
    PUSHBUTTON      "Clear", IDC_IMAGE_CLEAR, 234, 59, 28, 14
    LTEXT           "(blank = built-in emblem)", -1, 64, 76, 140, 10

    GROUPBOX        "Emblem panes", -1, 8, 90, 254, 46
    PUSHBUTTON      "Pane &1...", IDC_PANE1, 16, 104, 40, 14
    LTEXT           "", IDC_SWATCH1, 60, 104, 18, 14, SS_SUNKEN
    PUSHBUTTON      "Pane &2...", IDC_PANE2, 84, 104, 40, 14
    LTEXT           "", IDC_SWATCH2, 128, 104, 18, 14, SS_SUNKEN
    PUSHBUTTON      "Pane &3...", IDC_PANE3, 152, 104, 40, 14
    LTEXT           "", IDC_SWATCH3, 196, 104, 18, 14, SS_SUNKEN
    PUSHBUTTON      "Pane &4...", IDC_PANE4, 16, 120, 40, 14
    LTEXT           "", IDC_SWATCH4, 60, 120, 18, 14, SS_SUNKEN

    AUTOCHECKBOX    "&Spin", IDC_SPIN, 12, 144, 60, 10
    AUTOCHECKBOX    "Background s&tars", IDC_STARS, 84, 144, 100, 10

    PUSHBUTTON      "&Defaults", IDC_DEFAULTS, 12, 164, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 156, 164, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 210, 164, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Flying Windows screen saver (RetroSavers)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "FlyingWindows.scr"
            VALUE "OriginalFilename", "FlyingWindows.scr"
            VALUE "ProductName", "RetroSavers"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
