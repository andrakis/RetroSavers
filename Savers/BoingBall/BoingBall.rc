#include <windows.h>
#include <commctrl.h>
#include <scrnsave.h>
#include "resource.h"

// IDS_DESCRIPTION (1): the name shown in the Screen Saver Settings dropdown.
STRINGTABLE
BEGIN
    IDS_DESCRIPTION "Boing Ball"
END

ID_APP ICON "..\\..\\assets\\RetroSavers.ico"

DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 250, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Boing Ball Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Speed:", -1, 12, 12, 50, 10
    CONTROL         "", IDC_SPEED, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 8, 140, 18
    LTEXT           "5", IDC_SPEED_LABEL, 210, 12, 30, 10
    LTEXT           "&Ball size:", -1, 12, 36, 50, 10
    CONTROL         "", IDC_BALL_SIZE, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 32, 140, 18
    LTEXT           "5", IDC_BALL_SIZE_LABEL, 210, 36, 30, 10

    LTEXT           "Ball colours:", -1, 12, 62, 50, 10
    PUSHBUTTON      "Colour &1...", IDC_COLOR1, 64, 59, 50, 14
    LTEXT           "", IDC_SWATCH1, 118, 59, 24, 14, SS_SUNKEN
    PUSHBUTTON      "Colour &2...", IDC_COLOR2, 150, 59, 50, 14
    LTEXT           "", IDC_SWATCH2, 204, 59, 24, 14, SS_SUNKEN
    LTEXT           "Grid:", -1, 12, 82, 50, 10
    PUSHBUTTON      "Colou&r...", IDC_COLOR_GRID, 64, 79, 50, 14
    LTEXT           "", IDC_SWATCH_GRID, 118, 79, 24, 14, SS_SUNKEN
    AUTOCHECKBOX    "Show s&hadow", IDC_SHADOW, 12, 102, 100, 10

    PUSHBUTTON      "&Defaults", IDC_DEFAULTS, 12, 124, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 136, 124, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 190, 124, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Boing Ball screen saver (RetroSavers)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "BoingBall.scr"
            VALUE "OriginalFilename", "BoingBall.scr"
            VALUE "ProductName", "RetroSavers"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
