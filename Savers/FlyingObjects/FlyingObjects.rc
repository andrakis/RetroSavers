#include <windows.h>
#include <commctrl.h>
#include <scrnsave.h>
#include "resource.h"

// IDS_DESCRIPTION (1): the name shown in the Screen Saver Settings dropdown.
STRINGTABLE
BEGIN
    IDS_DESCRIPTION "3D Flying Objects"
END

ID_APP ICON "..\\..\\assets\\RetroSavers.ico"

DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 270, 190
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "3D Flying Objects Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Style:", -1, 12, 12, 50, 10
    COMBOBOX        IDC_STYLE, 64, 10, 110, 100, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "&Colours:", -1, 12, 32, 50, 10
    COMBOBOX        IDC_COLOR_MODE, 64, 30, 110, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    AUTOCHECKBOX    "&Wireframe", IDC_WIREFRAME, 186, 32, 70, 10
    LTEXT           "&Texture:", -1, 12, 52, 50, 10
    EDITTEXT        IDC_TEXTURE_PATH, 64, 50, 170, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_TEXTURE_BROWSE, 238, 49, 24, 14
    LTEXT           "(flag and logo; blank = built-in emblem)", -1, 64, 66, 180, 10

    LTEXT           "&Resolution:", -1, 12, 88, 50, 10
    CONTROL         "", IDC_RESOLUTION, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 84, 160, 18
    LTEXT           "5", IDC_RESOLUTION_LABEL, 230, 88, 30, 10
    LTEXT           "S&peed:", -1, 12, 112, 50, 10
    CONTROL         "", IDC_SPEED, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 108, 160, 18
    LTEXT           "5", IDC_SPEED_LABEL, 230, 112, 30, 10
    LTEXT           "Si&ze:", -1, 12, 136, 50, 10
    CONTROL         "", IDC_SIZE_TB, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 132, 160, 18
    LTEXT           "5", IDC_SIZE_LABEL, 230, 136, 30, 10

    PUSHBUTTON      "&Defaults", IDC_DEFAULTS, 12, 164, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 156, 164, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 210, 164, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "3D Flying Objects screen saver (RetroSavers)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "FlyingObjects.scr"
            VALUE "OriginalFilename", "FlyingObjects.scr"
            VALUE "ProductName", "RetroSavers"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
