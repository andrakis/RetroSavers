#include <windows.h>
#include <commctrl.h>
#include <scrnsave.h>
#include "resource.h"

// IDS_DESCRIPTION (1): the name shown in the Screen Saver Settings dropdown.
STRINGTABLE
BEGIN
    IDS_DESCRIPTION "Gears"
END

ID_APP ICON "..\\..\\assets\\RetroSavers.ico"

DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 250, 130
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Gears Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Speed:", -1, 12, 12, 50, 10
    CONTROL         "", IDC_SPEED, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 8, 140, 18
    LTEXT           "5", IDC_SPEED_LABEL, 210, 12, 30, 10

    LTEXT           "Gear colours:", -1, 12, 38, 50, 10
    PUSHBUTTON      "&1...", IDC_COLOR1, 64, 35, 24, 14
    LTEXT           "", IDC_SWATCH1, 92, 35, 18, 14, SS_SUNKEN
    PUSHBUTTON      "&2...", IDC_COLOR2, 120, 35, 24, 14
    LTEXT           "", IDC_SWATCH2, 148, 35, 18, 14, SS_SUNKEN
    PUSHBUTTON      "&3...", IDC_COLOR3, 176, 35, 24, 14
    LTEXT           "", IDC_SWATCH3, 204, 35, 18, 14, SS_SUNKEN

    AUTOCHECKBOX    "&Wireframe", IDC_WIREFRAME, 12, 60, 60, 10
    AUTOCHECKBOX    "&Drifting view", IDC_AUTOROTATE, 84, 60, 70, 10
    AUTOCHECKBOX    "Show &frame rate", IDC_FPS, 160, 60, 80, 10

    PUSHBUTTON      "D&efaults", IDC_DEFAULTS, 12, 104, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 136, 104, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 190, 104, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Gears screen saver (RetroSavers)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Gears.scr"
            VALUE "OriginalFilename", "Gears.scr"
            VALUE "ProductName", "RetroSavers"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
