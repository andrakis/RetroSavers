#include <windows.h>
#include <commctrl.h>
#include <scrnsave.h>
#include "resource.h"

// IDS_DESCRIPTION (1): the name shown in the Screen Saver Settings dropdown.
STRINGTABLE
BEGIN
    IDS_DESCRIPTION "Plasma"
END

ID_APP ICON "..\\..\\assets\\RetroSavers.ico"

DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 250, 124
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Plasma Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Speed:", -1, 12, 12, 50, 10
    CONTROL         "", IDC_SPEED, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 8, 140, 18
    LTEXT           "5", IDC_SPEED_LABEL, 210, 12, 30, 10
    LTEXT           "S&cale:", -1, 12, 36, 50, 10
    CONTROL         "", IDC_SCALE, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 32, 140, 18
    LTEXT           "5", IDC_SCALE_LABEL, 210, 36, 30, 10
    LTEXT           "&Palette:", -1, 12, 60, 50, 10
    COMBOBOX        IDC_PALETTE, 64, 58, 100, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "&Resolution:", -1, 12, 80, 50, 10
    COMBOBOX        IDC_RESOLUTION, 64, 78, 100, 60, CBS_DROPDOWNLIST | WS_TABSTOP

    PUSHBUTTON      "&Defaults", IDC_DEFAULTS, 12, 98, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 136, 98, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 190, 98, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Plasma screen saver (RetroSavers)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Plasma.scr"
            VALUE "OriginalFilename", "Plasma.scr"
            VALUE "ProductName", "RetroSavers"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
