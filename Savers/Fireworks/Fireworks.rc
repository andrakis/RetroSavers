#include <windows.h>
#include <commctrl.h>
#include <scrnsave.h>
#include "resource.h"

// IDS_DESCRIPTION (1): the name shown in the Screen Saver Settings dropdown.
STRINGTABLE
BEGIN
    IDS_DESCRIPTION "Fireworks"
END

ID_APP ICON "..\\..\\assets\\RetroSavers.ico"

DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 260, 196
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Fireworks Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Launch rate:", -1, 12, 12, 60, 10
    CONTROL         "", IDC_RATE, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 76, 8, 140, 18
    LTEXT           "5", IDC_RATE_LABEL, 220, 12, 34, 10
    LTEXT           "&Gravity:", -1, 12, 36, 60, 10
    CONTROL         "", IDC_GRAVITY, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 76, 32, 140, 18
    LTEXT           "5", IDC_GRAVITY_LABEL, 220, 36, 34, 10
    LTEXT           "&Trail:", -1, 12, 60, 60, 10
    CONTROL         "", IDC_TRAIL, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 76, 56, 140, 18
    LTEXT           "5", IDC_TRAIL_LABEL, 220, 60, 34, 10
    LTEXT           "&Bloom:", -1, 12, 84, 60, 10
    CONTROL         "", IDC_BLOOM, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 76, 80, 140, 18
    LTEXT           "5", IDC_BLOOM_LABEL, 220, 84, 34, 10
    LTEXT           "Burst &size:", -1, 12, 108, 60, 10
    CONTROL         "", IDC_BURST, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 76, 104, 140, 18
    LTEXT           "5", IDC_BURST_LABEL, 220, 108, 34, 10
    LTEXT           "&Finale every:", -1, 12, 132, 60, 10
    CONTROL         "", IDC_FINALE, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 76, 128, 140, 18
    LTEXT           "45 s", IDC_FINALE_LABEL, 220, 132, 34, 10

    PUSHBUTTON      "&Defaults", IDC_DEFAULTS, 12, 170, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 146, 170, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 170, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Fireworks screen saver (RetroSavers)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Fireworks.scr"
            VALUE "OriginalFilename", "Fireworks.scr"
            VALUE "ProductName", "RetroSavers"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
