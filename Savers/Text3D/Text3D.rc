#include <windows.h>
#include <commctrl.h>
#include <scrnsave.h>
#include "resource.h"

// IDS_DESCRIPTION (1): the name shown in the Screen Saver Settings dropdown.
STRINGTABLE
BEGIN
    IDS_DESCRIPTION "3D Text"
END

ID_APP ICON "..\\..\\assets\\RetroSavers.ico"

DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 300, 210
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "3D Text Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Text", -1, 8, 6, 284, 58
    LTEXT           "&Custom text:", -1, 16, 20, 50, 10
    EDITTEXT        IDC_TEXT, 68, 18, 216, 13, ES_AUTOHSCROLL
    AUTOCHECKBOX    "Show &time", IDC_SHOW_TIME, 16, 36, 50, 10
    AUTORADIOBUTTON "12 hour", IDC_H12, 72, 36, 44, 10, WS_GROUP
    AUTORADIOBUTTON "24 hour", IDC_H24, 120, 36, 44, 10
    PUSHBUTTON      "&Font...", IDC_FONT, 16, 48, 48, 13
    LTEXT           "Arial Bold", IDC_FONT_LABEL, 68, 50, 216, 10

    LTEXT           "&Size:", -1, 12, 74, 50, 10
    CONTROL         "", IDC_SIZE_TB, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 70, 100, 18
    LTEXT           "5", IDC_SIZE_LABEL, 168, 74, 20, 10
    LTEXT           "&Depth:", -1, 12, 96, 50, 10
    CONTROL         "", IDC_DEPTH, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 92, 100, 18
    LTEXT           "5", IDC_DEPTH_LABEL, 168, 96, 20, 10
    LTEXT           "&Resolution:", -1, 12, 118, 50, 10
    CONTROL         "", IDC_RESOLUTION, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 114, 100, 18
    LTEXT           "5", IDC_RESOLUTION_LABEL, 168, 118, 20, 10
    LTEXT           "S&peed:", -1, 12, 140, 50, 10
    CONTROL         "", IDC_SPEED, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 136, 100, 18
    LTEXT           "5", IDC_SPEED_LABEL, 168, 140, 20, 10

    LTEXT           "R&otation:", -1, 196, 74, 40, 10
    COMBOBOX        IDC_ROTATION, 236, 72, 56, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "S&urface:", -1, 196, 96, 40, 10
    COMBOBOX        IDC_SURFACE, 236, 94, 56, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Colour:", -1, 196, 118, 40, 10
    PUSHBUTTON      "Colour...", IDC_COLOR, 236, 115, 34, 14
    LTEXT           "", IDC_SWATCH, 274, 115, 18, 14, SS_SUNKEN
    AUTOCHECKBOX    "C&ycle colours", IDC_CYCLE, 196, 140, 90, 10

    LTEXT           "&Image:", -1, 12, 166, 50, 10
    EDITTEXT        IDC_IMAGE_PATH, 64, 164, 200, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_IMAGE_BROWSE, 268, 163, 24, 14

    PUSHBUTTON      "&Defaults", IDC_DEFAULTS, 12, 186, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 186, 186, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 240, 186, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "3D Text screen saver (RetroSavers)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Text3D.scr"
            VALUE "OriginalFilename", "Text3D.scr"
            VALUE "ProductName", "RetroSavers"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
