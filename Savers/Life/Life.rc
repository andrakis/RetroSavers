#include <windows.h>
#include <commctrl.h>
#include <scrnsave.h>
#include "resource.h"

// IDS_DESCRIPTION (1): the name shown in the Screen Saver Settings dropdown.
STRINGTABLE
BEGIN
    IDS_DESCRIPTION "Game of Life"
END

ID_APP ICON "..\\..\\assets\\RetroSavers.ico"

DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 260, 146
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Game of Life Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Cell size:", -1, 12, 12, 50, 10
    CONTROL         "", IDC_CELL, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 8, 150, 18
    LTEXT           "6", IDC_CELL_LABEL, 220, 12, 34, 10
    LTEXT           "&Speed:", -1, 12, 36, 50, 10
    CONTROL         "", IDC_TICK, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 32, 150, 18
    LTEXT           "12", IDC_TICK_LABEL, 220, 36, 34, 10
    LTEXT           "&Density:", -1, 12, 60, 50, 10
    CONTROL         "", IDC_DENSITY, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 56, 150, 18
    LTEXT           "30 %", IDC_DENSITY_LABEL, 220, 60, 34, 10

    LTEXT           "&Palette:", -1, 12, 86, 50, 10
    COMBOBOX        IDC_PALETTE, 64, 84, 100, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    AUTOCHECKBOX    "&Wrap around edges", IDC_WRAP, 12, 104, 100, 10
    AUTOCHECKBOX    "&Reseed when still", IDC_RESEED, 130, 104, 100, 10

    PUSHBUTTON      "&Defaults", IDC_DEFAULTS, 12, 120, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 146, 120, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 120, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Game of Life screen saver (RetroSavers)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Life.scr"
            VALUE "OriginalFilename", "Life.scr"
            VALUE "ProductName", "RetroSavers"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
