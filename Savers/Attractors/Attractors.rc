#include <windows.h>
#include <commctrl.h>
#include <scrnsave.h>
#include "resource.h"

// IDS_DESCRIPTION (1): the name shown in the Screen Saver Settings dropdown.
STRINGTABLE
BEGIN
    IDS_DESCRIPTION "Strange Attractors"
END

ID_APP ICON "..\\..\\assets\\RetroSavers.ico"

DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 260, 146
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Strange Attractors Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Attractor:", -1, 12, 12, 50, 10
    COMBOBOX        IDC_ATTRACTOR, 64, 10, 110, 90, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "&Colours:", -1, 12, 32, 50, 10
    COMBOBOX        IDC_COLOR_MODE, 64, 30, 110, 60, CBS_DROPDOWNLIST | WS_TABSTOP

    LTEXT           "&Particles:", -1, 12, 58, 50, 10
    CONTROL         "", IDC_PARTICLES, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 54, 140, 18
    LTEXT           "15000", IDC_PARTICLES_LABEL, 210, 58, 44, 10
    LTEXT           "&Trail:", -1, 12, 82, 50, 10
    CONTROL         "", IDC_TRAIL, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 78, 140, 18
    LTEXT           "6", IDC_TRAIL_LABEL, 210, 82, 44, 10
    LTEXT           "&Speed:", -1, 12, 106, 50, 10
    CONTROL         "", IDC_SPEED, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 64, 102, 140, 18
    LTEXT           "5", IDC_SPEED_LABEL, 210, 106, 44, 10

    PUSHBUTTON      "&Defaults", IDC_DEFAULTS, 12, 124, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 146, 124, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 124, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Strange Attractors screen saver (RetroSavers)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Attractors.scr"
            VALUE "OriginalFilename", "Attractors.scr"
            VALUE "ProductName", "RetroSavers"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
